{
  "name": "laravel-cloud-blueprint/cli",
  "description": "Declarative Infrastructure as Code for Laravel Cloud.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "symfony/console": "^7.4",
    "symfony/http-client": "^7.4",
    "symfony/yaml": "^7.4"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "LaravelCloudBlueprint\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LaravelCloudBlueprint\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/lcb"
  ],
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse",
    "check": [
      "@test",
      "@analyse"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}